{
  // Denna fil styr bara testmottagaren. Skapa separat Worker för produktion.
  "name": "luns-contact-preview",
  "main": "worker.mjs",
  "account_id": "8ce9451d9f605299a2384ec40a009581",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "CONTACT_MODE": "demo",
    "ALLOWED_ORIGINS": "http://10.0.1.34:3002,http://localhost:3002,http://127.0.0.1:3002",
    "TURNSTILE_HOSTNAMES": "10.0.1.34,localhost,127.0.0.1"
  },
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1041", "simple": { "limit": 5, "period": 60 } }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
